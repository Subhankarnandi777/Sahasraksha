DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres

# Optional local-only fallback. Do not enable this in shared Supabase deployments.
# SKYGUARD_ALLOW_SQLITE=true

# Optional explicit demo seed. Disabled by default so Supabase is not silently seeded.
# SKYGUARD_SEED_DEMO_DATA=true
